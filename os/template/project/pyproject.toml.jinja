[project]
name = "{{ project_slug }}"
version = "0.1.0"
description = "{{ description }}"
requires-python = ">={{ python_version }}"
dependencies = [
    "sconixlib",
    "pyyaml>=6",
    "rich>=13",
    "numpy>=1.26",
{%- if use_torch %}
    "torch>=2.7",
{%- endif %}
]

[dependency-groups]
dev = ["pytest>=8", "ruff>=0.6", "pre-commit>=4"]
viz = ["matplotlib>=3.8", "pandas>=2"]
# for `task lab` and `task report` (Quarto executes the .qmd with jupyter)
notebook = ["jupyterlab>=4", "ipykernel>=6", "jupyter-cache>=1"]

{% if use_torch -%}
[[tool.uv.index]]
name = "pytorch-cu128"
url = "https://download.pytorch.org/whl/cu128"
explicit = true

{% endif -%}
[tool.uv.sources]
sconixlib = { path = "{{ sconixlib_path }}", editable = true }
{%- if use_torch %}
torch = { index = "pytorch-cu128" }
{%- endif %}

[tool.ruff]
line-length = 100

[tool.ruff.lint]
select = ["E", "F", "I", "UP", "B"]

[tool.pytest.ini_options]
addopts = "-q"
testpaths = ["tests"]

[build-system]
requires = ["hatchling"]
build-backend = "hatchling.build"

[tool.hatch.build.targets.wheel]
packages = ["src/{{ module_name }}"]
